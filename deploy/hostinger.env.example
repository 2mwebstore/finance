# Settings for docker-compose.yml: copy to .env next to it (e.g. /var/www/finance/.env, chmod 600)
# and fill in your own values. Never commit real values.
# Make each secret with:  openssl rand -hex 32

# Your domains (each needs a DNS A record pointing at the VPS)
DOMAINS=rp001.pro, rph001.pro
CORS_ORIGINS=https://rp001.pro,https://rph001.pro

# Database
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Sign-in tokens: at least 32 random characters
JWT_SECRET=

# Only to create the first admin on a new database; empty it afterwards
SETUP_TOKEN=

# Where the data folders go (default ./data next to docker-compose.yml, e.g. /var/www/finance/data)
# DATA_DIR=/var/www/finance/data

# Only when a shared Caddy (another app's) already owns ports 80/443: this app's Caddy isn't started
# and the shared one forwards the domains to finance-app:8080 (docs/DEPLOY_HOSTINGER.md, "Sharing the
# server with another app").
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.shared-caddy.yml
# PROXY_NETWORK=the_shared_caddy_network

# Optional: daily backups and alerts to Telegram (the Backups page can set these too)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
