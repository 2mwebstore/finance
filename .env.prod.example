# Copy to .env.prod and fill real values. Never commit .env.prod.

# Domain
DOMAIN=finance.example.com
CORS_ORIGINS=https://finance.example.com

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_very_long
DB_NAME=income_expense
DB_USER=finance
DB_PASSWORD=change_me_db_very_long

# JWT (min 32 random chars)
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168

# First-run Super Admin provisioning (empty after setup)
SETUP_TOKEN=change_me_one_time_setup_token



# Start-up schema (AUTO_MIGRATE) and base data (AUTO_SEED, defaults to AUTO_MIGRATE).
AUTO_MIGRATE=true
AUTO_SEED=true

# Optional Telegram (database backups and alerts). The Backups page can also set these;
# values saved there win over these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where database backups are kept on the server (kept 7 days by default; change on the Backups page).
BACKUP_DIR=backups
