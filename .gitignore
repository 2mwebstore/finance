# Secrets: real values live in the host's environment (e.g. Railway variables), never in git.
.env
.env.*
!.env.example
!.env.prod.example

# Dependencies and build output (rebuilt by `npm ci` / `nuxt build` / Docker)
node_modules/
frontend/.nuxt/
frontend/.output/
frontend/dist/

# Attachments and database backups saved on local disk
backend/uploads/
backend/backups/

# OS files
.DS_Store
