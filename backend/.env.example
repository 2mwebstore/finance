# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=income-expense-api
TZ=Asia/Phnom_Penh

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=finance
DB_PASSWORD=change_me_strong_password
DB_NAME=income_expense
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Asia%2FPhnom_Penh

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL_MINUTES=15
JWT_ISSUER=income-expense-api
JWT_AUDIENCE=income-expense-web

# Refresh token
REFRESH_TOKEN_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Strict

# First-run setup (set to empty string after initialization)
SETUP_TOKEN=

# Rate limiting
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
