# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=income-expense-api
TZ=Asia/Phnom_Penh

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=finance
DB_PASSWORD=change_me_strong_password
DB_NAME=income_expense
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Asia%2FPhnom_Penh
# Print every SQL statement (local debugging only; far too chatty for hosted logs)
DB_LOG_SQL=false

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TTL_MINUTES=15
JWT_ISSUER=income-expense-api
JWT_AUDIENCE=income-expense-web

# Refresh token
REFRESH_TOKEN_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Strict

# First-run setup (set to empty string after initialization)
SETUP_TOKEN=

# Rate limiting
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Transaction attachments (one image/PDF per transaction) in Cloudflare R2.
# Leave all R2_* empty in development to store files under UPLOAD_DIR instead.
# Railway's disk is not persistent, so set these in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: full endpoint instead of R2_ACCOUNT_ID (e.g. <account>.r2.cloudflarestorage.com)
R2_ENDPOINT=
UPLOAD_DIR=uploads

# Start-up schema and data (always on when APP_ENV is development or test).
# AUTO_MIGRATE creates/updates tables; AUTO_SEED adds missing permissions, roles, categories and
# payment methods. AUTO_SEED follows AUTO_MIGRATE when it isn't set.
AUTO_MIGRATE=false
AUTO_SEED=
# Database backups (daily time, keep days and Telegram are set on the Backups page).
BACKUP_DIR=backups
