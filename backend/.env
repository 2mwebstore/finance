APP_ENV=development
APP_PORT=8080
APP_NAME=income-expense-api
TZ=Asia/Phnom_Penh

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=finance-v1
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Asia%2FPhnom_Penh

JWT_SECRET=dev_jwt_secret_change_in_production_32chars_min
JWT_ACCESS_TTL_MINUTES=15
JWT_ISSUER=income-expense-api
JWT_AUDIENCE=income-expense-web

REFRESH_TOKEN_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Strict

# First-run setup token (disable by setting empty after setup)
SETUP_TOKEN=dev-setup-token-change-me

LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
