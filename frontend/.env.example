# Copy to .env and adjust. Nuxt reads it on `npm run dev` / `npm run build`;
# at runtime NUXT_PUBLIC_API_BASE in the process environment overrides it.

# Base URL the browser uses for the API, including /api/v1.
# Recommended everywhere: same origin, so the refresh cookie is first-party.
#   - The app's own server proxies /api/v1 to API_PROXY_TARGET below (dev and production).
#   - With nginx in front (deploy/nginx), /api/ goes straight to the API; same result.
NUXT_PUBLIC_API_BASE=/api/v1

# Where this app's server forwards /api/v1 (server/routes/api/v1) — the Go API.
# Read at build/dev time; in production set NUXT_API_PROXY_TARGET at runtime instead
# (Railway: http://<api service>.railway.internal:8080).
API_PROXY_TARGET=http://localhost:8080

# Alternative: call the API on another origin directly, e.g.
#   NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
# This needs the web origin in CORS_ORIGINS (backend/.env), and the page and API must
# share a host name. Some browsers (Safari) still drop the refresh cookie across ports,
# which signs you out on every reload, so prefer the same-origin setup above.
