# Copy to .env and adjust. Nuxt reads it on `npm run dev` / `npm run build`;
# at runtime NUXT_PUBLIC_API_BASE in the process environment overrides it.

# Base URL the browser uses for the API, including /api/v1.
#
# Local development (API from backend/: `go run ./cmd/api`, port 8080):
#   NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
#   Open the app at http://localhost:3000 so the sign-in cookie stays same-site.
#
# Same domain behind a reverse proxy (what the Dockerfile builds by default):
#   NUXT_PUBLIC_API_BASE=/api/v1
#
# API on its own domain (add the web origin to CORS_ORIGINS in backend/.env and
# set COOKIE_SAME_SITE / COOKIE_DOMAIN so the refresh cookie is sent):
#   NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1
#
# Empty = call http://<page host>:8080/api/v1 (works for localhost and 127.0.0.1).
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
