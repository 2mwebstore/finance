{"file":"categories-dn42pZlQ.js","mappings":";;;;;;;;;;;;;;;;;;AAoEgB,WAAA;AAChB,UAAM,EAAE,IAAA,IAAQ,eAAA;AAChB,UAAM,YAAY,SAAS,MAAM,IAAI,mBAAmB,CAAC;AACzD,UAAM,aAAa,IAAgB,EAAE;AACrC,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,YAAY,IAAI,KAAK;AAC3B,UAAM,WAAW,IAAuB,QAAQ;AAChC,QAAqB,IAAI;AACzC,UAAM,SAAS,IAAI,KAAK;AACxB,UAAM,YAAY,IAAI,EAAE;AACxB,UAAM,aAAa,IAAI,KAAK;AAC5B,UAAM,OAAO,SAAS,EAAE,MAAM,IAAI,MAAM,IAAI,aAAa,IAAI,WAAW,KAAA,CAAM;AAE9E,UAAM,MAAM,KAAK,MAAM,CAAC,SAAS;AAC/B,UAAI,SAAS,UAAU,YAAY,CAAC,WAAW,MAAO,MAAK,OAAO,QAAQ,IAAI;AAAA,IAChF,CAAC;AACD,UAAM,MAAM,KAAK,MAAM,CAAC,SAAS;AAC/B,UAAI,SAAS,UAAU,YAAY,QAAQ,SAAS,QAAQ,KAAK,IAAI,EAAG,YAAW,QAAQ;AAAA,IAC7F,CAAC;AAED,aAAS,QAAQ,OAAe;AAC9B,aAAO,MAAM,cAAc,OAAO,QAAQ,eAAe,GAAG,EAAE,QAAQ,UAAU,EAAE;AAAA,IACpF;;AA1FW,YAAA,WAAAA,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,CAAA,0SAAA;UAORC,MAAA,SAAA,GAAS;;AACd,cAAAC,mBAAAD,MAAA,IAAA,GAAA,EAAA,MAAM,GAAA,GAAE,MAAA,OAAA,CAAA;;;;;;UAIRA,MAAA,OAAA,GAAO;;iBACFA,MAAA,KAAA,GAAK;8JACVA,MAAA,KAAA,CAAK,CAAA,4EAAA;AAAA;;AAGcE,sBAAAF,MAAA,UAAA,IAAZ,aAAQ;oOAG6BG,eAAA,SAAS,IAAI,sBACkBC,eAAA,CAAA,SAAS,YAAS,4BAAA,2BAAA,yDAAA,CAAA,MAA6DD,eAAA,SAAS,YAAS,WAAA,UAAA;AACnK,cAAA,SAAS,WAAS;;;;;0EAEoBA,eAAA,SAAS,IAAI,OAASA,eAAA,SAAS,IAAI;AAC9E,cAAA,SAAS,aAAW;AAAqC,kBAAA,sCAAAA,eAAA,SAAS,WAAW,CAAA,MAAA;AAAA;;;;cAE1EH,MAAA,SAAA,GAAS;;AAAmL,kBAAAC,mBAAAD,MAAA,MAAA,GAAA,EAAA,MAAM,GAAA,GAAE,MAAA,OAAA,CAAA;;;;;;;;AAExM,YAAA,CAAAA,MAAA,UAAA,EAAW,QAAM;;;;;;;UAGpBA,MAAA,SAAA,GAAS;mRACsHK,cAAA,cAAYL,MAAA,QAAA,MAAQ,WAAA,iBAAA,eAAA,kLAE1EA,MAAA,QAAA,MAAQ,WAAA,iBAAA,iBAAA,sEAA2GA,MAAA,QAAA,MAAQ,WAAA,iBAAA,eAAA;AACnE,cAAAC,mBAAAD,MAAA,CAAA,GAAA,EAAA,MAAM,GAAA,GAAE,MAAA,OAAA,CAAA;uJAItGK,cAAA,SAAAL,MAAA,IAAA,EAAK,IAAI,sPAGTK,cAAA,SAAAL,MAAA,IAAA,EAAK,IAAI,0NACAA,MAAA,QAAA,MAAQ,WAAA,8DAAA,wEAAA,oTAGgDG,eAAAH,MAAA,IAAA,EAAK,WAAW;YAE5GA,MAAA,QAAA,MAAQ,QAAA;AACH,gBAAA,wHAAAM,sBAAA,MAAA,QAAAN,MAAA,IAAA,EAAK,SAAS,IAAdO,gBAAAP,MAAA,IAAA,EAAK,WAAS,IAAA,IAAdA,MAAA,IAAA,EAAK,SAAS,IAAA,aAAA,EAAA,iGAAA;AAAA;;;YAEvBA,MAAA,SAAA,GAAS;8GAA8EA,MAAA,SAAA,CAAS,CAAA,MAAA;AAAA;;;kNAEaA,MAAA,MAAA,CAAM,IAAA,cAAA,6JACIA,MAAA,MAAA,CAAM,IAAA,cAAA,qBAAKA,MAAA,MAAA,IAAM,YAAA,eAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderComponent","_ssrRenderList","_ssrInterpolate","_ssrRenderClass","_ssrRenderAttr","_ssrIncludeBooleanAttr","_ssrLooseContain"],"sources":["../../../../pages/admin/categories.vue"],"sourcesContent":["<template>\n  <section class=\"space-y-4\">\n    <header class=\"flex flex-wrap items-center justify-between gap-3\">\n      <div>\n        <p class=\"text-[10px] font-bold tracking-[0.14em] text-slate-400\">SETUP</p>\n        <h1 class=\"text-xl font-bold text-navy\">Categories</h1>\n        <p class=\"mt-1 text-xs text-muted\">Manage the categories available on expense forms.</p>\n      </div>\n      <button v-if=\"canManage\" class=\"inline-flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-sm font-medium text-white hover:bg-primary-hover\" @click=\"openCreate\">\n        <Plus :size=\"16\" /> Add category\n      </button>\n    </header>\n\n    <div v-if=\"loading\" class=\"rounded-xl border border-border bg-white p-6 text-center text-sm text-muted\">Loading categories…</div>\n    <div v-else-if=\"error\" class=\"flex items-center justify-between gap-3 rounded-xl border border-red-100 bg-white p-4 text-sm text-expense\">\n      <span>{{ error }}</span><button class=\"font-semibold text-primary\" @click=\"load\">Try again</button>\n    </div>\n    <div v-else class=\"overflow-hidden rounded-xl border border-border bg-white\">\n      <article v-for=\"category in categories\" :key=\"category.id\" class=\"flex items-start justify-between gap-4 border-b border-border p-4 last:border-0\">\n        <div class=\"min-w-0\">\n          <div class=\"flex flex-wrap items-center gap-2\">\n            <h2 class=\"text-sm font-semibold text-navy\">{{ category.name }}</h2>\n            <span class=\"rounded-full px-2 py-0.5 text-[9px] font-bold uppercase\" :class=\"category.is_active ? 'bg-green-50 text-income' : 'bg-slate-100 text-muted'\">{{ category.is_active ? 'Active' : 'Inactive' }}</span>\n            <span v-if=\"category.is_system\" class=\"rounded-full bg-blue-50 px-2 py-0.5 text-[9px] font-bold uppercase text-primary\">System</span>\n          </div>\n          <p class=\"mt-1 font-mono text-[10px] text-muted\">{{ category.code }} · {{ category.type }}</p>\n          <p v-if=\"category.description\" class=\"mt-1 text-xs text-muted\">{{ category.description }}</p>\n        </div>\n        <button v-if=\"canManage\" class=\"inline-flex shrink-0 items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-navy hover:bg-canvas\" @click=\"openEdit(category)\"><Pencil :size=\"13\" /> Edit</button>\n      </article>\n      <div v-if=\"!categories.length\" class=\"p-8 text-center text-sm text-muted\">No expense categories yet. Add a category to make it available on expense forms.</div>\n    </div>\n\n    <div v-if=\"modalOpen\" class=\"fixed inset-0 z-[90] flex items-end justify-center bg-slate-950/50 p-0 backdrop-blur-sm sm:items-center sm:p-5\" @click.self=\"close\">\n      <section class=\"w-full max-w-lg rounded-t-2xl border border-border bg-white shadow-2xl sm:rounded-2xl\" role=\"dialog\" aria-modal=\"true\" :aria-label=\"formMode === 'create' ? 'Add category' : 'Edit category'\">\n        <header class=\"flex items-center justify-between border-b border-border px-5 py-4\">\n          <div><p class=\"text-[9px] font-extrabold tracking-[0.14em] text-slate-400\">{{ formMode === 'create' ? 'NEW CATEGORY' : 'UPDATE CATEGORY' }}</p><h2 class=\"mt-1 text-base font-bold text-navy\">{{ formMode === 'create' ? 'Add category' : 'Edit category' }}</h2></div>\n          <button class=\"grid h-8 w-8 place-items-center rounded-lg bg-canvas text-muted hover:text-navy\" aria-label=\"Close\" @click=\"close\"><X :size=\"17\" /></button>\n        </header>\n        <form class=\"space-y-3 p-5\" @submit.prevent=\"save\">\n          <label class=\"block space-y-1.5 text-xs font-semibold text-navy\">\n            <span>Name</span><input v-model.trim=\"form.name\" required minlength=\"2\" maxlength=\"128\" class=\"w-full rounded-lg border border-border px-3 py-2.5 font-normal\" placeholder=\"e.g. Office supplies\" />\n          </label>\n          <label class=\"block space-y-1.5 text-xs font-semibold text-navy\">\n            <span>Code</span><input v-model.trim=\"form.code\" required minlength=\"2\" maxlength=\"64\" class=\"w-full rounded-lg border border-border px-3 py-2.5 font-mono font-normal\" placeholder=\"e.g. office-supplies\" />\n            <small class=\"block font-normal text-muted\">{{ formMode === 'create' ? 'Generated from the name; you can adjust it before saving.' : 'Changing the code keeps existing transactions linked to this category.' }}</small>\n          </label>\n          <label class=\"block space-y-1.5 text-xs font-semibold text-navy\">\n            <span>Description <small class=\"font-normal text-muted\">Optional</small></span><textarea v-model.trim=\"form.description\" rows=\"2\" maxlength=\"512\" class=\"w-full rounded-lg border border-border px-3 py-2.5 font-normal\" placeholder=\"Add a short description\" />\n          </label>\n          <label v-if=\"formMode === 'edit'\" class=\"flex items-center gap-2 rounded-lg border border-border bg-canvas px-3 py-2.5 text-xs text-navy\">\n            <input v-model=\"form.is_active\" type=\"checkbox\" class=\"accent-primary\" /> Category is active and available on new forms\n          </label>\n          <p v-if=\"formError\" class=\"rounded-lg bg-red-50 px-3 py-2 text-xs text-expense\" role=\"alert\">{{ formError }}</p>\n          <footer class=\"flex justify-end gap-2 border-t border-border pt-4\">\n            <button type=\"button\" class=\"rounded-lg border border-border px-4 py-2 text-xs font-semibold text-muted\" :disabled=\"saving\" @click=\"close\">Cancel</button>\n            <button type=\"submit\" class=\"rounded-lg bg-primary px-4 py-2 text-xs font-semibold text-white disabled:opacity-60\" :disabled=\"saving\">{{ saving ? 'Saving…' : 'Save category' }}</button>\n          </footer>\n        </form>\n      </section>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { Pencil, Plus, X } from 'lucide-vue-next'\nimport type { Category } from '~/types/api'\n\nconst { api } = useApi()\nconst { can } = usePermissions()\nconst canManage = computed(() => can('categories.manage'))\nconst categories = ref<Category[]>([])\nconst loading = ref(true)\nconst error = ref('')\nconst modalOpen = ref(false)\nconst formMode = ref<'create' | 'edit'>('create')\nconst editing = ref<Category | null>(null)\nconst saving = ref(false)\nconst formError = ref('')\nconst codeEdited = ref(false)\nconst form = reactive({ name: '', code: '', description: '', is_active: true })\n\nwatch(() => form.name, (name) => {\n  if (formMode.value === 'create' && !codeEdited.value) form.code = slugify(name)\n})\nwatch(() => form.code, (code) => {\n  if (formMode.value === 'create' && code && code !== slugify(form.name)) codeEdited.value = true\n})\n\nfunction slugify(value: string) {\n  return value.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')\n}\n\nasync function load() {\n  loading.value = true\n  error.value = ''\n  try {\n    const result = await api<{ items: Category[] }>('/categories', { query: { type: 'expense' } })\n    categories.value = (result.items || []).filter((category) => category.type === 'expense')\n  } catch (e: any) {\n    error.value = e?.data?.error || 'Could not load categories.'\n  } finally {\n    loading.value = false\n  }\n}\n\nfunction openCreate() {\n  formMode.value = 'create'\n  editing.value = null\n  Object.assign(form, { name: '', code: '', description: '', is_active: true })\n  codeEdited.value = false\n  formError.value = ''\n  modalOpen.value = true\n}\n\nfunction openEdit(category: Category) {\n  formMode.value = 'edit'\n  editing.value = category\n  Object.assign(form, { name: category.name, code: category.code, description: category.description || '', is_active: category.is_active })\n  formError.value = ''\n  modalOpen.value = true\n}\n\nfunction close() {\n  if (!saving.value) modalOpen.value = false\n}\n\nasync function save() {\n  saving.value = true\n  formError.value = ''\n  try {\n    if (formMode.value === 'create') {\n      await api('/categories', { method: 'POST', body: { type: 'expense', name: form.name, code: form.code, description: form.description } })\n    } else if (editing.value) {\n      await api(`/categories/${editing.value.id}`, { method: 'PATCH', body: { code: form.code, name: form.name, description: form.description, is_active: form.is_active } })\n    }\n    modalOpen.value = false\n    await load()\n  } catch (e: any) {\n    formError.value = e?.data?.error || 'Could not save this category.'\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(load)\n</script>\n"],"version":3}