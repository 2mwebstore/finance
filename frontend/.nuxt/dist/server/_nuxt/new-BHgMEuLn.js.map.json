{"file":"new-BHgMEuLn.js","mappings":";;;;;;;;;;;;;;;;;;;;;AAYA,UAAM,QAAQ,SAAA;AACd,UAAM,EAAE,iBAAiB,kBAAkB,qBAAqB,iBAAA,IAAqB,eAAA;AACrF,UAAM,YAAY,IAAI,IAAI;AAE1B,UAAM,kBAAkB,SAA+B,MAAM;AAC3D,UAAI,MAAM,MAAM,SAAS,aAAa,iBAAiB,MAAO,QAAO;AACrE,UAAI,MAAM,MAAM,SAAS,YAAY,gBAAgB,MAAO,QAAO;AACnE,UAAI,gBAAgB,MAAO,QAAO;AAClC,aAAO;AAAA,IACT,CAAC;AAED,aAAS,uBAAuB;AAC9B,UAAI,oBAAoB,MAAO,QAAO,WAAW,eAAe;AAChE,UAAI,iBAAiB,MAAO,QAAO,WAAW,YAAY;AAC1D,aAAO,WAAW,OAAO;AAAA,IAC3B;AAEA,aAAS,cAAc,MAAe;AACpC,gBAAU,QAAQ;AAClB,UAAI,CAAC,KAAM,sBAAA;AAAA,IACb;;;AA/BO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,2BAAuB,MAAA,CAAA,CAAA,mBAAA;;QAE7B,eAAaC,MAAA,SAAA;AAAA,QACb,MAAMA,MAAA,eAAA;AAAA,QACP,MAAK;AAAA,QACJ,uBAAoB;AAAA,MAAA;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref"],"sources":["../../../../pages/transactions/new.vue"],"sourcesContent":["<template>\n  <div class=\"new-transaction-route\">\n    <TransactionModal\n      :model-value=\"modalOpen\"\n      :type=\"transactionType\"\n      mode=\"create\"\n      @update:model-value=\"onModalChange\"\n    />\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst route = useRoute()\nconst { canCreateIncome, canCreateExpense, canViewTransactions, canViewDashboard } = usePermissions()\nconst modalOpen = ref(true)\n\nconst transactionType = computed<'income' | 'expense'>(() => {\n  if (route.query.type === 'expense' && canCreateExpense.value) return 'expense'\n  if (route.query.type === 'income' && canCreateIncome.value) return 'income'\n  if (canCreateIncome.value) return 'income'\n  return 'expense'\n})\n\nfunction returnToPreviousPage() {\n  if (canViewTransactions.value) return navigateTo('/transactions')\n  if (canViewDashboard.value) return navigateTo('/dashboard')\n  return navigateTo('/more')\n}\n\nfunction onModalChange(open: boolean) {\n  modalOpen.value = open\n  if (!open) returnToPreviousPage()\n}\n</script>\n\n<style scoped>\n.new-transaction-route { min-height: calc(100vh - 110px); }\n</style>\n"],"version":3}