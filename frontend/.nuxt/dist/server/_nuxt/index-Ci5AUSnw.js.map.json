id; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 7px; margin-top: 9px; }\n.totals-equation > div { display: flex; min-width: 0; flex-direction: column; gap: 3px; }\n.totals-equation small { color: #8797ad; font-size: 8px; }\n.totals-equation strong { overflow: hidden; font-size: 12px; font-variant-numeric: tabular-nums; text-overflow: ellipsis; white-space: nowrap; }\n.equation-operator { color: #96a4b7; font-size: 13px; font-weight: 700; }\n.mobile-load-more { display: flex; min-height: 40px; align-items: center; justify-content: center; color: #8292a9; font-size: 10px; }\n.mobile-load-more > span { display: inline-flex; align-items: center; gap: 7px; }\n.pagination-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; border: 1px solid #e3eaf4; border-radius: 9px; padding: 9px 11px; color: #8191a8; background: #fff; font-size: 9px; }\n.pagination-controls { display: flex; align-items: center; gap: 7px; }\n.page-size-control { display: flex; align-items: center; gap: 5px; }\n.page-size-control :deep(.search-select) { width: 75px; }\n.page-size-control :deep(.search-select-trigger) { min-height: 29px; padding: 5px 7px; font-size: 9px; }\n.page-size-control select { min-height: 29px; }\n.page-button { min-height: 29px; padding: 0 9px; }\n.page-button:disabled { color: #aab5c3; background: #f7f9fb; cursor: not-allowed; }\n.page-indicator { min-width: 62px; color: #526985; text-align: center; }\n.type-filters { display: inline-flex; gap: 3px; border: 1px solid #e2e9f3; border-radius: 9px; padding: 3px; background: #fff; }\n.type-filters button { border: 0; border-radius: 6px; padding: 7px 11px; color: #70829d; background: transparent; font-size: 10px; font-weight: 650; cursor: pointer; white-space: nowrap; }\n.type-filters button.active { color: #fff; background: #1769e8; box-shadow: 0 3px 7px rgb(23 105 232 / 18%); }\n.type-scope { display: inline-flex; align-i