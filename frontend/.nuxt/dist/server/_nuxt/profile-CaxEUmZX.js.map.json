{"file":"profile-CaxEUmZX.js","mappings":";;;;;;;;;;;;;;;;;AAiCgB,WAAA;AAChB,UAAM,EAAE,KAAA,IAAS,QAAA;AACjB,UAAM,OAAO,SAAS,EAAE,kBAAkB,IAAI,cAAc,IAAI;AAChE,UAAM,eAAe,IAAI,EAAE;AAC3B,UAAM,SAAS,IAAI,KAAK;AACxB,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,SAAS,IAAI,EAAE;;uBAtCVA,eAAAC,WAAA,EAAA,OAAM,8BAAA,GAA6B,MAAA,CAAA,4gBAUsDC,eAAAC,MAAA,IAAA,GAAM,aAAS,GAAA,uGAChBD,eAAAC,MAAA,IAAA,GAAM,YAAQ,GAAA,8GACPD,eAAAC,MAAA,IAAA,GAAM,SAAK,GAAA,oHACpBA,MAAA,IAAA,GAAM,SAAK,CAAA,GAAQ,KAAI,IAAA,KAAA,GAAA,2VAMpBC,cAAA,SAAAD,MAAA,IAAA,EAAK,gBAAgB,yRAEpBC,cAAA,SAAAD,MAAA,IAAA,EAAK,YAAY,mVACjBA,MAAA,YAAA,CAAY;UAElGA,MAAA,KAAA,GAAK;4GAA8EA,MAAA,KAAA,CAAK,CAAA,MAAA;AAAA;;;UACxFA,MAAA,MAAA,GAAM;8GAAgFA,MAAA,MAAA,CAAM,CAAA,MAAA;AAAA;;;0DACpEA,MAAA,MAAA,CAAM,IAAA,cAAA,qIAAqHA,MAAA,MAAA,IAAM,cAAA,iBAAA;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderAttr"],"sources":["../../../../pages/profile.vue"],"sourcesContent":["<template>\n  <section class=\"mx-auto max-w-2xl space-y-5\">\n    <header>\n      <p class=\"text-[10px] font-bold tracking-[0.14em] text-slate-400\">ACCOUNT</p>\n      <h1 class=\"text-xl font-bold text-navy\">Your profile</h1>\n      <p class=\"mt-1 text-sm text-muted\">Manage your account details and sign-in PIN.</p>\n    </header>\n\n    <article class=\"rounded-xl border border-border bg-white p-4 sm:p-5\">\n      <h2 class=\"text-sm font-semibold text-navy\">Account details</h2>\n      <dl class=\"mt-3 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2\">\n        <div><dt class=\"text-xs text-muted\">Full name</dt><dd class=\"mt-1 font-medium text-navy\">{{ user?.full_name || '—' }}</dd></div>\n        <div><dt class=\"text-xs text-muted\">Username</dt><dd class=\"mt-1 font-medium text-navy\">{{ user?.username || '—' }}</dd></div>\n        <div><dt class=\"text-xs text-muted\">Email</dt><dd class=\"mt-1 break-all font-medium text-navy\">{{ user?.email || '—' }}</dd></div>\n        <div><dt class=\"text-xs text-muted\">Roles</dt><dd class=\"mt-1 font-medium text-navy\">{{ (user?.roles || []).join(', ') || '—' }}</dd></div>\n      </dl>\n    </article>\n\n    <form class=\"space-y-4 rounded-xl border border-border bg-white p-4 sm:p-5\" @submit.prevent=\"changePassword\">\n      <div><h2 class=\"text-sm font-semibold text-navy\">Change password</h2><p class=\"mt-1 text-xs text-muted\">Your new password must be exactly 4 digits.</p></div>\n      <label class=\"block space-y-1 text-xs font-medium text-muted\">Current password<input v-model=\"form.current_password\" type=\"password\" required autocomplete=\"current-password\" class=\"w-full rounded-lg border border-border px-3 py-2.5 text-sm text-navy\" /></label>\n      <div class=\"grid grid-cols-1 gap-3 sm:grid-cols-2\">\n        <label class=\"block space-y-1 text-xs font-medium text-muted\">New 4-digit PIN<input v-model=\"form.new_password\" type=\"password\" inputmode=\"numeric\" pattern=\"[0-9]{4}\" maxlength=\"4\" minlength=\"4\" required autocomplete=\"new-password\" class=\"w-full rounded-lg border border-border px-3 py-2.5 text-sm text-navy\" placeholder=\"4 digits\" /></label>\n        <label class=\"block space-y-1 text-xs font-medium text-muted\">Confirm new PIN<input v-model=\"confirmation\" type=\"password\" inputmode=\"numeric\" pattern=\"[0-9]{4}\" maxlength=\"4\" minlength=\"4\" required autocomplete=\"new-password\" class=\"w-full rounded-lg border border-border px-3 py-2.5 text-sm text-navy\" placeholder=\"Enter the PIN again\" /></label>\n      </div>\n      <p v-if=\"error\" class=\"rounded-lg bg-red-50 px-3 py-2 text-xs text-expense\" role=\"alert\">{{ error }}</p>\n      <p v-if=\"notice\" class=\"rounded-lg bg-green-50 px-3 py-2 text-xs text-income\" role=\"status\">{{ notice }}</p>\n      <button type=\"submit\" :disabled=\"saving\" class=\"w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white disabled:opacity-60 sm:w-auto\">{{ saving ? 'Updating…' : 'Update password' }}</button>\n    </form>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst { api } = useApi()\nconst { user } = useAuth()\nconst form = reactive({ current_password: '', new_password: '' })\nconst confirmation = ref('')\nconst saving = ref(false)\nconst error = ref('')\nconst notice = ref('')\n\nasync function changePassword() {\n  error.value = ''\n  notice.value = ''\n  if (form.new_password !== confirmation.value) {\n    error.value = 'PINs do not match.'\n    return\n  }\n  saving.value = true\n  try {\n    await api('/auth/change-password', { method: 'POST', body: form })\n    Object.assign(form, { current_password: '', new_password: '' })\n    confirmation.value = ''\n    notice.value = 'Your password was updated.'\n  } catch (e: any) {\n    error.value = e?.data?.error || 'Could not change your password.'\n  } finally {\n    saving.value = false\n  }\n}\n</script>\n"],"version":3}