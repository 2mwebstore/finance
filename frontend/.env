# Frontend → API connection (local development)
#
# The browser calls the API on this app's own origin (/api/v1). The app's server
# (server/routes/api/v1) forwards those requests to the Go API at API_PROXY_TARGET (backend/.env APP_PORT=8080),
# the same way nginx does in production. Keeping one origin means the sign-in
# refresh cookie is first-party, so reloading the page keeps you signed in in
# every browser (Safari included), on localhost or 127.0.0.1.
NUXT_PUBLIC_API_BASE=/api/v1
API_PROXY_TARGET=http://localhost:8080
