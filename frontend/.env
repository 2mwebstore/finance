# Frontend → API connection (local development)
#
# The Go API listens on APP_PORT=8080 (see backend/.env), and its CORS_ORIGINS
# allows http://localhost:3000 and http://127.0.0.1:3000.
#
# Open the app at http://localhost:3000 (same host name as below). The sign-in
# refresh cookie is SameSite=Strict, so mixing localhost and 127.0.0.1 logs you
# out on reload. To use 127.0.0.1 instead, change both to 127.0.0.1, or leave
# the value empty to always call http://<page host>:8080/api/v1.
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
